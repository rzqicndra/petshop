REDIS_URL=redis://redis:6379/0
PAYMENT_MODE=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
